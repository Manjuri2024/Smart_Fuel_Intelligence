# Copy this file to backend/.env and fill in your values. NEVER share or commit backend/.env.

# ---------------- Web addresses ----------------
# Use "localhost" (not 127.0.0.1) for BOTH the frontend and the API so the login cookie works.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only when the site is served over HTTPS (production).
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
REMEMBER_TTL_DAYS=30

# ---------------- First administrator (optional) ----------------
# On startup, if no user with ADMIN_EMAIL exists, an admin account is created.
# REMOVE ADMIN_PASSWORD from this file after the first start. (Alternative: the command-line method in README.)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---------------- Google sign-in (optional) ----------------
# See README "Google sign-in" for the step-by-step setup. Leave empty to disable the Google buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---------------- Password-reset e-mail (optional) ----------------
RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# DEVELOPMENT ONLY: with no SMTP, print the reset link in the backend terminal. Never enable in production.
DEV_PRINT_RESET_LINKS=false

# ---------------- AI assistant (optional) ----------------
# Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: change the SQLite file location (default: database/fuelwise.db)
# FUELWISE_DB_PATH=

# Emission assumptions used for the CO2 card (approximate, adjust for your region)
PETROL_CO2_KG_PER_LITRE=2.31
GRID_CO2_KG_PER_KWH=0.71
